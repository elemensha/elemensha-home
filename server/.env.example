# 데이터 경로. 비우면 server/data 를 쓴다. 배포 시에는 설치 스크립트가
# /opt/<앱>/data 로 채운다 (systemd 가 그 경로에만 쓰기를 허용한다).
HOME_DATA_DIR=

# 앱 접근 토큰. 운영에서는 반드시 채울 것 (비우면 인증 없이 열린다)
HOME_API_TOKEN=

# 공공데이터포털 일반 인증키(Decoding). data.go.kr에서 활용신청 후 발급
ONBID_SERVICE_KEY=
RTMS_SERVICE_KEY=
APPLYHOME_SERVICE_KEY=

# 법원경매 유료 중계 API를 붙일 경우
COURT_API_KEY=

# 감시 지역
TARGET_SIDO=서울특별시,경기도,인천광역시

# 폴링 주기(분)
ONBID_INTERVAL_MIN=60
RTMS_INTERVAL_MIN=720
APPLYHOME_INTERVAL_MIN=360
KEEP_DAYS=90

# 텔레그램 알림(선택)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
